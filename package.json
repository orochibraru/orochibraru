{
	"name": "orochibraru.com",
	"private": true,
	"type": "module",
	"scripts": {
		"prepare": "svelte-kit sync && (prek install || echo 'prek not installed: skipping git hooks')",
		"dev": "vite dev",
		"build": "bun run schema && vite build",
		"preview": "vite preview",
		"check:app": "rm -rf .svelte-kit/.svelte-check && svelte-kit sync && svelte-check --tsgo --tsconfig ./tsconfig.json --threshold error",
		"lint": "biome check . && tailwint 'src/**/*.{css,svelte}'",
		"lint:fix": "biome check --write . && tailwint --fix 'src/**/*.{css,svelte}'",
		"format": "biome format --write . && prettier --write '**/*.md'",
		"audit": "bun run scripts/lighthouse.ts",
		"docs": "bun run scripts/docs.ts",
		"schema": "bun run scripts/schema.ts"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.14",
		"@fontsource-variable/geist": "^5.3.0",
		"@fontsource-variable/geist-mono": "^5.3.0",
		"@lucide/svelte": "^1.46.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/language-server": "^0.16.0",
		"@tailwindcss/vite": "^4.3.3",
		"@types/bun": "^1.4.2",
		"@typescript/native": "npm:typescript@7",
		"lighthouse": "^13.4.1",
		"markdownlint-cli2": "^0.23.2",
		"prettier": "^3.9.7",
		"shiki": "^4.4.3",
		"svelte": "^5.57.0",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.3",
		"tailwint": "^1.1.16",
		"typescript": "~6",
		"vite": "^8.3.0",
		"zod": "^4.6.5"
	}
}
