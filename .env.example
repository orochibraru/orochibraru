# Copy to .env: Bun loads it for `bun run dev`, the server binary and scripts.
# Docker takes the same variables with -e or an env file.

# The public URL, no trailing slash. Links, OAuth and the MCP resource are built from it.
ORIGIN=http://localhost:5173

# openssl rand -hex 32. Seals sessions, OAuth signing keys and the GitHub App's
# key: set it once and never change it on a deployed instance.
AUTH_SECRET=

# Where site.db and images/ live. ./data when unset; /data in the Docker image.
# DATA_DIR=data

# SSO for /admin and the MCP server. Leave OIDC_ISSUER empty and the site runs
# without either. Register ORIGIN/api/auth/callback/sso as the redirect URI.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Comma-separated. Only these addresses get in, checked on every request.
ADMIN_EMAILS=
